<Window x:Class="BD_RGR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BD_RGR.Services"
        xmlns:views="clr-namespace:BD_RGR.Views"
        Title="{loc:Loc AppName}" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen"
        Width="1330" Height="780" MinWidth="970" MinHeight="620" Language="{Binding UiLanguage}">
    <Window.Resources>
        <DataTemplate x:Key="SidebarEntry">
            <RadioButton Style="{StaticResource NavItem}" GroupName="WorkspaceNav"
                         IsChecked="{Binding IsActive, Mode=OneWay}" Command="{Binding Activate}" Margin="0,0,0,2">
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource TranslateKey}">
                            <Binding Path="TitleKey" />
                            <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}">
            <Grid Margin="14,20,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,18">
                    <Border Style="{StaticResource BrandMark}">
                        <TextBlock Text="↗" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{loc:Loc AppName}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" IsEnabled="{Binding CanNavigate}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Menu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding ExpandedByDefault, Mode=OneTime}"
                                          Foreground="{DynamicResource SidebarTextBrush}" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource TranslateKey}">
                                                        <Binding Path="TitleKey" />
                                                        <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Expander.Header>
                                        <StackPanel Margin="12,4,4,0">
                                            <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource SidebarEntry}" />
                                            <StackPanel Visibility="{Binding HasRelatedEntries, Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Text="{loc:Loc Relations}" Foreground="{DynamicResource SidebarTextBrush}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="8,10,0,4" />
                                                <ItemsControl ItemsSource="{Binding RelatedEntries}" ItemTemplate="{StaticResource SidebarEntry}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource SidebarEntry}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="4,12,4,0">
                    <Border Height="1" Background="{DynamicResource FocusBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Session.Username}" Foreground="White" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource SidebarTextBrush}" TextWrapping="Wrap" Margin="0,2,0,9">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                <Binding Path="Session.Role.TitleKey" />
                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Content="{loc:Loc SignOut}" IsEnabled="{Binding CanUseAccountActions}" Click="SignOut_Click" />
                    <TextBlock Foreground="{DynamicResource SidebarTextBrush}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding HasSidebarNotice, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                <Binding Path="AccountNotice.Key" />
                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                <Binding Path="AccountNotice.Field" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Style="{StaticResource Heading}" Margin="0,3,0,0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource TranslateKey}">
                            <Binding Path="TitleKey" />
                            <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding PageChoices}"
                          Visibility="{Binding ShowsPageChoices, Converter={StaticResource BooleanToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="232" MinHeight="52" Margin="0,0,10,10" Command="{Binding Activate}">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TranslateKey}">
                                        <Binding Path="TitleKey" />
                                        <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:SettingsView Grid.Row="1" DataContext="{Binding Preferences}"
                    Visibility="{Binding DataContext.ShowsSettings, RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibility}}" />

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top"
                    HorizontalAlignment="Left" Width="400" IsVisibleChanged="PasswordForm_IsVisibleChanged"
                    Visibility="{Binding ShowsPasswordChange, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <Label Content="{loc:Loc CurrentPassword}" Target="{Binding ElementName=CurrentPasswordInput}" />
                    <PasswordBox x:Name="CurrentPasswordInput" MaxLength="1024" Margin="0,0,0,12"
                                 IsEnabled="{Binding CanUseAccountActions}" />
                    <Label Content="{loc:Loc NewPassword}" Target="{Binding ElementName=NewPasswordInput}" />
                    <PasswordBox x:Name="NewPasswordInput" MaxLength="1024" Margin="0,0,0,12"
                                 IsEnabled="{Binding CanUseAccountActions}" />
                    <Label Content="{loc:Loc RepeatPassword}" Target="{Binding ElementName=RepeatNewPasswordInput}" />
                    <PasswordBox x:Name="RepeatNewPasswordInput" MaxLength="1024" Margin="0,0,0,14"
                                 IsEnabled="{Binding CanUseAccountActions}" />
                    <Button Content="{loc:Loc Save}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanUseAccountActions}" IsDefault="{Binding ShowsPasswordChange}"
                            Click="ChangePassword_Click" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                <Binding Path="AccountNotice.Key" />
                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                <Binding Path="AccountNotice.Field" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <views:DocumentsView Grid.Row="1" DataContext="{Binding Documents}"
                    Visibility="{Binding DataContext.ShowsDocuments, RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibility}}" />
            <Button Grid.Row="1" Content="{loc:Loc OpenAnalytics}" Click="Analytics_Click"
                    VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                    Visibility="{Binding ShowsAnalytics, Converter={StaticResource BooleanToVisibility}}" />
            <views:HelpView Grid.Row="1" Visibility="{Binding ShowsHelp, Converter={StaticResource BooleanToVisibility}}" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top" HorizontalAlignment="Left"
                    Visibility="{Binding ShowsAbout, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel MaxWidth="620">
                    <TextBlock Text="{loc:Loc AppName}" Style="{StaticResource Subheading}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc AboutText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc AboutCourse}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc AboutTechnology}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <views:BusinessTableView Grid.Row="1" DataContext="{Binding DataTable}"
                    Visibility="{Binding DataContext.ShowsTable, RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </Grid>
</Window>
