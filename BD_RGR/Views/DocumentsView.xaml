<UserControl x:Class="BD_RGR.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services">
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12">
                <Label Content="{loc:Loc ManualSqlLabel}" Target="{Binding ElementName=SqlInput}" />
                <TextBlock Text="{loc:Loc ManualSqlHint}" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                <TextBox x:Name="SqlInput" FontFamily="Consolas" MinHeight="95" MaxLength="8192"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{loc:Loc ManualSqlLabel}"
                         Text="{Binding Sql, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc RunReport}" IsEnabled="{Binding IsReady}"
                        Click="Run_Click" Margin="0,0,8,0" />
                <Button Content="{loc:Loc ExportCsv}" IsEnabled="{Binding CanExport}" Click="Csv_Click" />
            </WrapPanel>
            <DataGrid Grid.Row="2" x:Name="ReportGrid" ItemsSource="{Binding Rows}"
                      CanUserSortColumns="False" AutomationProperties.Name="{loc:Loc ReportRows}" />
            <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource MutedText}"
                       Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</UserControl>
