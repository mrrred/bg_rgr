<UserControl x:Class="BD_RGR.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views">
    <Border Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel MinWidth="265">
            <Label Content="{loc:Loc Language}" />
            <views:LanguagePicker HorizontalAlignment="Left" Margin="0,0,0,14" />
            <CheckBox Content="{loc:Loc HighContrast}" IsChecked="{Binding HighContrast}" Margin="0,0,0,10" />
            <CheckBox Content="{loc:Loc LargeText}" IsChecked="{Binding LargeText}" Margin="0,0,0,10" />
            <CheckBox Content="{loc:Loc CompactRows}" IsChecked="{Binding CompactRows}" />
            <TextBlock Text="{loc:Loc PreferencesSaveError}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                       Visibility="{Binding SaveError, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
