<UserControl x:Class="BD_RGR.Views.BusinessFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"
                   Visibility="{Binding HasSection, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource TranslateKey}">
                    <Binding Path="Section" />
                    <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="#A4262C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource TranslateKey}">
                    <Binding Path="Field.TitleKey" />
                    <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                 Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibility}}" />
        <views:LocalizedDatePicker SelectedDate="{Binding DateValue}" SelectedDateFormat="Short"
                    Visibility="{Binding EditableDate, Converter={StaticResource BooleanToVisibility}}" />
        <DockPanel Visibility="{Binding CanSearch, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Find}" Click="Find_Click" Margin="6,0,0,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                     AutomationProperties.Name="{loc:Loc FindRelated}" KeyDown="Find_KeyDown" />
        </DockPanel>
        <ComboBox x:Name="Options" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  IsEnabled="{Binding Editable}" DisplayMemberPath="Label" DropDownOpened="Options_Opened"
                  Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibility}}" />
    </StackPanel>
</UserControl>
