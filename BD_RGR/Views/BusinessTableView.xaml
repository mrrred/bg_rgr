<UserControl x:Class="BD_RGR.Views.BusinessTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="VehicleStatusCell">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center" Focusable="False">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource StatusAttentionBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.Values[status]}" Value="исправен">
                                    <Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding [status]}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid IsEnabled="{Binding IsReady}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="315" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button Content="{loc:Loc BackToTable}" HorizontalAlignment="Left" Click="Back_Click"
                            Margin="0,0,0,8" Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                 AutomationProperties.Name="{loc:Loc Search}" KeyDown="Search_KeyDown" />
                        <Button Grid.Column="1" Content="{loc:Loc Find}" Margin="6,0,0,0" Click="Search_Click" />
                        <Button Grid.Column="2" Content="{loc:Loc Add}" Style="{StaticResource PrimaryButton}"
                                Margin="6,0,0,0" Click="Add_Click"
                                Visibility="{Binding CanAdd, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>
                </StackPanel>

                <Expander Grid.Row="1" Header="{loc:Loc MileageCalculation}" Margin="0,0,0,8"
                          Visibility="{Binding ShowsMileage, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Margin="0,8,0,0">
                        <views:BusinessFieldView DataContext="{Binding MileageVehicle}" />
                        <WrapPanel>
                            <views:LocalizedDatePicker SelectedDate="{Binding FromDate}" AutomationProperties.Name="{loc:Loc DateFrom}"
                                        MinWidth="148" Margin="0,0,6,4" />
                            <views:LocalizedDatePicker SelectedDate="{Binding ToDate}" AutomationProperties.Name="{loc:Loc DateTo}"
                                        MinWidth="148" Margin="0,0,6,4" />
                            <Button Content="{loc:Loc Calculate}" Click="Calculate_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selection, Mode=TwoWay}"
                              Sorting="RowsGrid_Sorting" PreviewMouseLeftButtonUp="RowsGrid_MouseUp"
                              PreviewKeyDown="RowsGrid_KeyDown" />
                    <TextBlock Text="{loc:Loc NoRows}" Style="{StaticResource MutedText}" Margin="12,64,8,0"
                               IsHitTestVisible="False" VerticalAlignment="Top"
                               Visibility="{Binding ShowsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="‹" AutomationProperties.Name="{loc:Loc PreviousPage}" IsEnabled="{Binding CanGoPrevious}"
                                Click="Previous_Click" />
                        <TextBlock Text="{Binding DisplayPage}" VerticalAlignment="Center" Margin="8,0" />
                        <Button Content="›" AutomationProperties.Name="{loc:Loc NextPage}" IsEnabled="{Binding CanGoNext}"
                                Click="Next_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,0,8,0"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc RecordCard}" Style="{StaticResource Subheading}" Margin="0,0,0,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0" Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:BusinessFieldView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasRelated, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{loc:Loc RelatedRecords}" Style="{StaticResource MutedText}" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding Related}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,5" Click="Related_Click">
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource TranslateKey}">
                                                        <Binding Path="TitleKey" />
                                                        <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Save}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4" Click="Save_Click"
                            Visibility="{Binding CanSave, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Content="{loc:Loc Cancel}" Margin="0,0,6,4" Click="Cancel_Click"
                            Visibility="{Binding CanSave, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Content="{loc:Loc Delete}" Margin="0,0,0,4" Click="Delete_Click"
                            Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibility}}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
