<Window x:Class="BD_RGR.Views.AppDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BD_RGR.Services"
        Style="{StaticResource AppWindow}" Width="510" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Padding="20" Margin="16">
        <StackPanel>
            <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Message" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
            <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Click="Accept_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
