<UserControl x:Class="BD_RGR.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             SizeChanged="Layout_Changed">
    <UserControl.Resources>
        <Style x:Key="DashboardFilterLayout" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <DataTemplate x:Key="DashboardFilterField">
            <Grid Width="172" Style="{StaticResource DashboardFilterLayout}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" SharedSizeGroup="DashboardFilterInput" />
                </Grid.RowDefinitions>
                <Label Target="{Binding ElementName=Options}">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </Label>
                <ComboBox x:Name="Options" Grid.Row="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CardContent">
            <StackPanel>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Subheading}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding Unit}" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                </WrapPanel>
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DashboardTablePanel">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subheading}" Margin="0,0,0,8">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                <Binding Path="TitleKey" />
                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <views:DashboardGrid Table="{Binding}" MaxHeight="360" Style="{StaticResource {x:Type DataGrid}}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableColumnVirtualization="True" />
                    <TextBlock Text="{loc:Loc AnalyticsEmpty}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="AnalyticsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <TextBlock Text="{Binding ScreenTitle}" Style="{StaticResource Subheading}" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding HasScreen, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <WrapPanel x:Name="FilterBar" Grid.IsSharedSizeScope="True" IsEnabled="{Binding IsReady}">
                        <Grid Style="{StaticResource DashboardFilterLayout}"
                              Visibility="{Binding HasPeriod, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" SharedSizeGroup="DashboardFilterInput" />
                            </Grid.RowDefinitions>
                            <Label Content="{loc:Loc DashboardDateFrom}" Target="{Binding ElementName=StartDate}" />
                            <views:LocalizedDatePicker x:Name="StartDate" Grid.Row="1" MinWidth="152" SelectedDate="{Binding From}" SelectedDateFormat="Short" />
                        </Grid>
                        <Grid Style="{StaticResource DashboardFilterLayout}"
                              Visibility="{Binding HasPeriod, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" SharedSizeGroup="DashboardFilterInput" />
                            </Grid.RowDefinitions>
                            <Label Content="{loc:Loc DashboardDateTo}" Target="{Binding ElementName=EndDate}" />
                            <views:LocalizedDatePicker x:Name="EndDate" Grid.Row="1" MinWidth="152" SelectedDate="{Binding To}" SelectedDateFormat="Short" />
                        </Grid>
                        <Button x:Name="ApplyButton" Content="{loc:Loc DashboardApply}" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom" Padding="9,6" Margin="0,0,6,6" Click="Apply_Click" />
                        <Button Content="{loc:Loc DashboardReset}" VerticalAlignment="Bottom" Padding="9,6" Margin="0,0,0,6" Click="Reset_Click" />
                    </WrapPanel>
                    <TextBlock Text="{Binding FilterError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasInvalidPeriod, Converter={StaticResource BooleanToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="164" Margin="0,0,8,8">
                            <Border Padding="11">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Open}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardContent}" Focusable="False" />
                            </Border>
                            <Button Content="{Binding}" ContentTemplate="{StaticResource CardContent}" Command="{Binding Open}" Padding="10">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource SoftGreenBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Open}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding HeatTables}" ItemTemplate="{StaticResource DashboardTablePanel}" />
            <ItemsControl x:Name="ChartPanels" ItemsSource="{Binding Charts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <primitives:UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,8,8">
                            <StackPanel>
                                <views:AnalyticsChart Height="295" Plot="{Binding}" DrillRequested="Chart_DrillRequested"
                                                      Scope="{Binding DataContext.ChartScope, RelativeSource={RelativeSource AncestorType=views:AnalyticsView}}"
                                                      TextSize="{DynamicResource UiFontSize}" Paper="{DynamicResource PaperBrush}"
                                                      Ink="{DynamicResource InkBrush}" GridLine="{DynamicResource BorderBrush}"
                                                      Bars="{DynamicResource ChartBarBrush}" Second="{DynamicResource ChartSecondBrush}"
                                                      Third="{DynamicResource ChartThirdBrush}" Fourth="{DynamicResource ChartFourthBrush}">
                                    <AutomationProperties.Name>
                                        <MultiBinding Converter="{StaticResource TranslateKey}">
                                            <Binding Path="TitleKey" />
                                            <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                        </MultiBinding>
                                    </AutomationProperties.Name>
                                </views:AnalyticsChart>
                                <Button Content="{loc:Loc ExportChart}" IsEnabled="{Binding HasValues}" Click="Export_Click"
                                        HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding SummaryTables}" ItemTemplate="{StaticResource DashboardTablePanel}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
