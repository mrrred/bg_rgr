<UserControl x:Class="BD_RGR.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views">
    <ScrollViewer x:Name="AnalyticsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=AnalyticsScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,8,4">
                    <Label Content="{loc:Loc AnalyticsMetric}" Target="{Binding ElementName=MetricInput}" />
                    <ComboBox x:Name="MetricInput" MinWidth="200" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Selected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource TranslateKey}">
                                            <Binding Path="TitleKey" />
                                            <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <Label Content="{loc:Loc DateFrom}" Target="{Binding ElementName=FromInput}" />
                    <views:LocalizedDatePicker x:Name="FromInput" MinWidth="148" SelectedDate="{Binding From}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <Label Content="{loc:Loc DateTo}" Target="{Binding ElementName=ToInput}" />
                    <views:LocalizedDatePicker x:Name="ToInput" MinWidth="148" SelectedDate="{Binding To}" SelectedDateFormat="Short" />
                </StackPanel>
                <Button Content="{loc:Loc RefreshAnalytics}" IsEnabled="{Binding IsReady}" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Margin="0,0,8,4" Click="Refresh_Click" />
                <Button Content="{loc:Loc ExportPng}" IsEnabled="{Binding CanExport}" VerticalAlignment="Bottom"
                    Margin="0,0,0,4" Click="Png_Click" />
            </WrapPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9">
                <views:AnalyticsChart x:Name="Chart" Snapshot="{Binding Snapshot}" ChartTitle="{Binding ChartTitle}"
                                  Period="{Binding ChartPeriod}" AutomationProperties.Name="{Binding ChartTitle}"
                                  MinHeight="280" TextSize="{DynamicResource UiFontSize}"
                                  Paper="{DynamicResource PaperBrush}" Ink="{DynamicResource InkBrush}"
                                  GridLine="{DynamicResource BorderBrush}" Bars="{DynamicResource ChartBarBrush}"
                                  Marker="{DynamicResource ChartMarkerBrush}" />
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource MutedText}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0" />
        </Grid>
    </ScrollViewer>
</UserControl>
