<UserControl x:Class="BD_RGR.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource Card}" Padding="22" MaxWidth="930" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{loc:Loc Tables}" Style="{StaticResource Subheading}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc HelpTables}" TextWrapping="Wrap" Margin="0,0,0,17" />
                <TextBlock Text="{loc:Loc Documents}" Style="{StaticResource Subheading}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc HelpDocuments}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Image x:Name="ReportImage" HorizontalAlignment="Left" MaxWidth="800" Stretch="Uniform"
                       AutomationProperties.Name="{loc:Loc HelpReportImage}" Margin="0,0,0,16" />
                <TextBlock Text="{loc:Loc Analytics}" Style="{StaticResource Subheading}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc HelpAnalytics}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Image x:Name="AnalyticsImage" HorizontalAlignment="Left" MaxWidth="800" Stretch="Uniform"
                       AutomationProperties.Name="{loc:Loc HelpAnalyticsImage}" Margin="0,0,0,16" />
                <TextBlock Text="{loc:Loc Settings}" Style="{StaticResource Subheading}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc HelpSettings}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
