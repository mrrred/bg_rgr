<UserControl x:Class="BD_RGR.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BD_RGR.Services"
             xmlns:views="clr-namespace:BD_RGR.Views">
    <UserControl.Resources>
        <views:GuideScreenshotConverter x:Key="GuideScreenshot" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="ContentsButton" Content="{loc:Loc GuideBackToContents}" Click="Contents_Click"
                HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="Collapsed" />
        <ScrollViewer x:Name="GuideScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <Border x:Name="Contents" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Subheading}" Text="{loc:Loc GuideContents}" />
                        <TextBlock Text="{loc:Loc GuideIntro}" TextWrapping="Wrap" Margin="0,8,0,16" />
                        <ItemsControl x:Name="TopicList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="240" MinHeight="52" Margin="0,0,8,8" Click="Topic_Click">
                                        <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource TranslateKey}">
                                                    <Binding Path="TitleKey" />
                                                    <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ContentControl x:Name="Article" Focusable="False" Visibility="Collapsed">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Subheading}" Margin="0,0,0,12">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource TranslateKey}">
                                            <Binding Path="TitleKey" />
                                            <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource UiLabelSize}"
                                                               TextWrapping="Wrap" Margin="0,0,0,7">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                                                <Binding Path="TitleKey" />
                                                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource TranslateKey}">
                                                                <Binding Path="TextKey" />
                                                                <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <StackPanel Margin="0,12,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Screenshot}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Image HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly"
                                                               AutomationProperties.LabeledBy="{Binding ElementName=FigureCaption}">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource GuideScreenshot}">
                                                                    <Binding Path="Screenshot" />
                                                                    <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                        <TextBlock x:Name="FigureCaption" Style="{StaticResource MutedText}" Margin="0,6,0,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource TranslateKey}">
                                                                    <Binding Path="CaptionKey" />
                                                                    <Binding Path="Language" Source="{x:Static loc:Translation.Current}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
